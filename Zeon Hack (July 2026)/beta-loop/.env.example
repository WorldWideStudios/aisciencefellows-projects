# Copy to .env and fill in. Do not commit .env.

# Vertex AI (uses GCP billing / $300 credit via ADC — no API key needed)
GOOGLE_GENAI_USE_ENTERPRISE=TRUE
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

PAPERCLIP_API_KEY=pk_...

# Optional — open literature repository rate limits (see .cursor/skills/scientific-literature/SKILL.md)
NCBI_API_KEY=
S2_API_KEY=
OPENALEX_API_KEY=
OPENALEX_MAILTO=your@email.example
