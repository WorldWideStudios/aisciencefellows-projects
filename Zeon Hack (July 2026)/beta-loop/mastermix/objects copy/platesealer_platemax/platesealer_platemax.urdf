<?xml version='1.0' encoding='utf-8'?>
<robot name="platesealer_platemax">
  <link name="world" />
  <joint name="world_joint" type="fixed">
    <parent link="world" />
    <child link="body" />
    <origin rpy="0 0 0" xyz="0 0 0" />
  </joint>
  <link name="body">
    <visual><geometry><mesh filename="base.ply" /></geometry></visual>
    <collision><geometry><mesh filename="base.ply" /></geometry></collision>
  </link>
  <joint name="drawer_joint" type="prismatic">
    <parent link="body" />
    <child link="plate_drawer" />
    <origin xyz="0.131700 -0.027858 -0.668596" rpy="0 0 0" />
    <axis xyz="0.863860 -0.336786 0.374596" />
    <limit lower="0.0" upper="0.1310" effort="0.0" velocity="0.0" />
  </joint>
  <link name="plate_drawer">
    <visual><geometry><mesh filename="plate_drawer.ply" /></geometry></visual>
    <collision><geometry><mesh filename="plate_drawer.ply" /></geometry></collision>
  </link>
</robot>
