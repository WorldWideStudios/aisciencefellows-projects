      }
    },
    {
      "edge_id": "e1",
      "from_node": "move_holder_position_0",
      "to_node": "move_holder_position_open_0",
      "condition": {
        "type": "on_success"
      }
    },
    {
      "edge_id": "e2",
      "from_node": "move_holder_position_open_0",
      "to_node": "move_grab_holder_1",
      "condition": {
        "type": "on_success"
      }
    },
    {
      "edge_id": "e3",
      "from_node": "move_grab_holder_1",
      "to_node": "move_grab_holder_up_2",
      "condition": {
        "type": "on_success"
      }
    },
    {
      "edge_id": "e4",
      "from_node": "move_grab_holder_up_2",
      "to_node": "move_grab_holder_back_3",
      "condition": {
        "type": "on_success"
      }
    },
    {
      "edge_id": "e5",
      "from_node": "move_grab_holder_back_3",
      "to_node": "move_grab_holder_set_down_4",
      "condition": {
        "type": "on_success"
      }
    },
    {
      "edge_id": "e6",
      "from_node": "move_grab_holder_set_down_4",
      "to_node": "move_grab_holder_release_5",
      "condition": {
        "type": "on_success"
      }
    },
    {
      "edge_id": "e7",
      "from_node": "move_grab_holder_release_5",
      "to_node": "end_1",
      "condition": {
        "type": "on_success"
      }
    }
  ]
